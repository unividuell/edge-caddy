# ==========================================================
#  edge-caddy secrets. NEVER commit this file (see .gitignore).
#
#  IMPORTANT: wrap every hash in SINGLE quotes.
#  Docker Compose interpolates '$' in .env values, and a bcrypt
#  hash contains three of them. Unquoted AND double-quoted both
#  eat the '$…' sequences, leaving "$2a$14" plus whatever follows
#  the last one — about 38 characters, varying with the salt.
#  Only single quotes survive.
#  A Caddy hash is always exactly 60 characters, so update.sh
#  requires exactly this shape and refuses to deploy otherwise:
#    NEWS_AUTH_HASH='$2a$14$.....................................................'
#
#  Generate a hash with:
#    docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# ==========================================================

# --- news.zingler46.unividuell.org (both users share one hash) ---
NEWS_AUTH_USER_1=
NEWS_AUTH_USER_2=
NEWS_AUTH_HASH=''

# --- stats.unividuell.org (traffic dashboard) ---
# Slot 1 is required. The Caddyfile declares slots 2 and 3 as well, but only the
# variables below are passed into the container. To add a user, fill a pair here
# AND add the matching two lines to the edge service's environment: in
# compose.yaml — setting them here alone has no effect.
# A slot left unset drops out of the config entirely. A HALF-filled slot (user
# without hash) fails to adapt, which update.sh catches before deploying.
STATS_AUTH_USER_1=
STATS_AUTH_HASH_1=''

#STATS_AUTH_USER_2=
#STATS_AUTH_HASH_2=''

#STATS_AUTH_USER_3=
#STATS_AUTH_HASH_3=''

# --- monitoring.unividuell.org (Grafana; required) ---
MONITORING_AUTH_USER_1=
MONITORING_AUTH_HASH_1=''

# --- monitoring: project databases (required) ---
# Password of countdown's read-only `monitor` role, same value as MONITORING_DB_PASSWORD
# in countdown's .env.prod and .env.staging. No `$` in it; e.g. `openssl rand -hex 24`.
COUNTDOWN_DB_MONITOR_PASSWORD=

# --- monitoring: alert mail via Gmail (required) ---
# The Gmail address (sender and recipient) and an app password for it
# (myaccount.google.com/apppasswords, needs 2-step verification), without the spaces.
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
