# ==========================================================
#  edge-caddy secrets. NEVER commit this file (see .gitignore).
#
#  IMPORTANT: wrap every hash in SINGLE quotes.
#  Docker Compose interpolates '$' in .env values, and a bcrypt
#  hash contains three of them. Unquoted AND double-quoted both
#  eat the '$…' sequences, leaving "$2a$14" plus whatever follows
#  the last one — about 38 characters, varying with the salt.
#  Only single quotes survive.
#  A Caddy hash is always exactly 60 characters, so update.sh
#  requires exactly this shape and refuses to deploy otherwise:
#    STATS_AUTH_HASH='$2a$14$.....................................................'
#
#  Generate a hash with:
#    docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# ==========================================================

# --- stats.unividuell.org (Grafana; required) ---
STATS_AUTH_USER=
STATS_AUTH_HASH=''

# --- wildcard certificate *.unividuell.org (required) ---
# Cloudflare API token for the DNS-01 challenge. Create it at dash.cloudflare.com →
# My Profile → API Tokens → Create Token, from the "Edit zone DNS" template:
#   Permissions:      Zone · DNS · Edit  and  Zone · Zone · Read
#   Zone Resources:   Include · Specific zone · unividuell.org
#   Client IP Address Filtering:  Is in · 158.101.161.126  (the server)
#   TTL:              none — an expired token stops every renewal at once
# Paste it as is; it contains no `$`. Surrounding quotes, trailing spaces and a trailing
# ` # comment` are stripped by Compose and do no harm. Caddy checks what is left at start and
# refuses anything that does not look like a token — braces, a truncated or doubled paste —
# and with it the whole edge; update.sh's validation gate catches that before anything is
# restarted.
CLOUDFLARE_API_TOKEN=

# --- monitoring: project databases (required) ---
# Password of countdown's read-only `monitor` role, same value as MONITORING_DB_PASSWORD
# in countdown's .env.prod and .env.staging. No `$` in it; e.g. `openssl rand -hex 24`.
COUNTDOWN_DB_MONITOR_PASSWORD=

# --- monitoring: alert mail via Gmail (required) ---
# The sending Gmail address and an app password for it (myaccount.google.com/apppasswords,
# needs 2-step verification), without the spaces; and where alerts go,
# e.g. a plus address of the same account (name+alerts@gmail.com) to filter on.
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=
