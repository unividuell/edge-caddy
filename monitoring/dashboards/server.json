{
  "uid": "server",
  "title": "Server",
  "tags": ["unividuell"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "schemaVersion": 39,
  "panels": [
    {"type": "stat", "title": "Apps (actuator health)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 14, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "label_replace(max by (http_url) (httpcheck_status{http_status_class=\"2xx\"}), \"app\", \"$1\", \"http_url\", \"http://(.+?)(-core-1)?:.*\")", "legendFormat": "{{app}}", "instant": true}], "fieldConfig": {"defaults": {"decimals": 0, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name"}, "id": 10},
    {"type": "stat", "title": "Backup-Spiegel (thin): letzter Lauf vor", "description": "Läuft alle 12 h; thin ist manchmal tagelang aus. Alert ab 4 Tagen.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 14, "y": 0, "w": 10, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "time() - max by (app) (last_over_time(backup_mirror_last_success_timestamp_seconds[30d]))", "legendFormat": "{{app}}", "instant": true}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 86400}, {"color": "red", "value": 345600}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name"}, "id": 11},
    {"type": "stat", "title": "CPU", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 4, "w": 6, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "1 - avg(system_cpu_utilization_ratio{service_name=\"host\", state=\"idle\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.9}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 1},
    {"type": "stat", "title": "RAM", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 6, "y": 4, "w": 6, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(system_memory_utilization_ratio{service_name=\"host\", state=\"used\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.9}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 2},
    {"type": "stat", "title": "Platte", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 4, "w": 6, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(system_filesystem_utilization_ratio{service_name=\"host\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.9}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 3},
    {"type": "stat", "title": "Load (1 min)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 18, "y": 4, "w": 6, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "system_cpu_load_average_1m{service_name=\"host\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 2}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 4},
    {"type": "timeseries", "title": "CPU / RAM / Platte", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "1 - avg(system_cpu_utilization_ratio{service_name=\"host\", state=\"idle\"})", "legendFormat": "CPU"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(system_memory_utilization_ratio{service_name=\"host\", state=\"used\"})", "legendFormat": "RAM"}, {"refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(system_filesystem_utilization_ratio{service_name=\"host\"})", "legendFormat": "Platte"}], "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"fillOpacity": 15}}, "overrides": []}, "id": 5},
    {"type": "timeseries", "title": "Log-Zeilen / min je Projekt", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (service_namespace) (count_over_time({service_namespace=~\".+\"}[1m]))", "legendFormat": "{{service_namespace}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"fillOpacity": 15}}, "overrides": []}, "id": 6},
    {"type": "timeseries", "title": "Edge: Requests / min je Host", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (request_host) (count_over_time({service_namespace=\"edge-caddy\", service_name=\"access-log\"} | json | __error__=\"\" [1m]))", "legendFormat": "{{request_host}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"fillOpacity": 15, "stacking": {"mode": "normal"}}}, "overrides": []}, "id": 7},
    {"type": "timeseries", "title": "Edge: Antworten / min nach Status", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (status) (count_over_time({service_namespace=\"edge-caddy\", service_name=\"access-log\"} | json | __error__=\"\" [1m]))", "legendFormat": "{{status}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"fillOpacity": 15}}, "overrides": []}, "id": 8},
    {"type": "logs", "title": "Fehler aller Container", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"x": 0, "y": 24, "w": 24, "h": 12}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "{service_namespace=~\".+\"} | detected_level=~\"(?i)(error|fatal|critical)\""}], "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true}, "id": 9}
  ]
}
