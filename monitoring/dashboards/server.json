{
  "uid": "server",
  "title": "Server",
  "tags": ["unividuell"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "schemaVersion": 39,
  "panels": [
    {"type": "stat", "title": "CPU", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "1 - avg(system_cpu_utilization_ratio{service_name=\"host\", state=\"idle\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.9}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 1},
    {"type": "stat", "title": "RAM", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(system_memory_utilization_ratio{service_name=\"host\", state=\"used\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.9}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 2},
    {"type": "stat", "title": "Platte", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(system_filesystem_utilization_ratio{service_name=\"host\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.9}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 3},
    {"type": "stat", "title": "Load (1 min)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "system_cpu_load_average_1m{service_name=\"host\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 2}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 4},
    {"type": "timeseries", "title": "CPU / RAM / Platte", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "1 - avg(system_cpu_utilization_ratio{service_name=\"host\", state=\"idle\"})", "legendFormat": "CPU"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(system_memory_utilization_ratio{service_name=\"host\", state=\"used\"})", "legendFormat": "RAM"}, {"refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(system_filesystem_utilization_ratio{service_name=\"host\"})", "legendFormat": "Platte"}], "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"fillOpacity": 15}}, "overrides": []}, "id": 5},
    {"type": "timeseries", "title": "Log-Zeilen / min je Projekt", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (service_namespace) (count_over_time({service_namespace=~\".+\"}[1m]))", "legendFormat": "{{service_namespace}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"fillOpacity": 15}}, "overrides": []}, "id": 6},
    {"type": "timeseries", "title": "Edge: Antworten / min nach Status", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (status) (count_over_time({service_namespace=\"edge-caddy\", service_name=\"access-log\"} | json | __error__=\"\" [1m]))", "legendFormat": "{{status}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"fillOpacity": 15}}, "overrides": []}, "id": 7},
    {"type": "logs", "title": "Fehler aller Container", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"x": 0, "y": 20, "w": 24, "h": 12}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "{service_namespace=~\".+\"} | detected_level=~\"ERROR|error|FATAL|fatal|critical\""}], "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true}, "id": 8}
  ]
}
