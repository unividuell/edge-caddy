{
  "uid": "mobility-manager",
  "title": "mobility-manager",
  "tags": ["mobility-manager"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "schemaVersion": 39,
  "panels": [
    {"type": "stat", "title": "Requests / min", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(http_server_requests_milliseconds_count{service_namespace=\"mobility-manager\", uri!~\"/actuator.*\"}[1m])) * 60", "instant": true}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 1},
    {"type": "stat", "title": "5xx (1 h)", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(http_server_requests_milliseconds_count{service_namespace=\"mobility-manager\", status=~\"5..\"}[1h])) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"}, "id": 2},
    {"type": "timeseries", "title": "Requests / min nach Status", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (status) (rate(http_server_requests_milliseconds_count{service_namespace=\"mobility-manager\", uri!~\"/actuator.*\"}[1m])) * 60", "legendFormat": "{{status}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"fillOpacity": 15, "stacking": {"mode": "normal"}}}, "overrides": []}, "id": 3},
    {"type": "timeseries", "title": "p95-Latenz je Endpoint", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_milliseconds_bucket{service_namespace=\"mobility-manager\", uri!~\"/actuator.*\"}[5m])))", "legendFormat": "{{uri}}"}], "fieldConfig": {"defaults": {"unit": "ms", "custom": {"fillOpacity": 15, "stacking": {"mode": "none"}}}, "overrides": []}, "id": 4},
    {"type": "timeseries", "title": "JVM-Speicher", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (area) (jvm_memory_used_bytes{service_namespace=\"mobility-manager\"})", "legendFormat": "{{area}}"}], "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"fillOpacity": 15, "stacking": {"mode": "none"}}}, "overrides": []}, "id": 5},
    {"type": "timeseries", "title": "DB-Verbindungen", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "hikaricp_connections_active{service_namespace=\"mobility-manager\"}", "legendFormat": "aktiv"}, {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "hikaricp_connections_pending{service_namespace=\"mobility-manager\"}", "legendFormat": "wartend"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"fillOpacity": 15, "stacking": {"mode": "none"}}}, "overrides": []}, "id": 6},
    {"type": "timeseries", "title": "Log-Zeilen / min nach Level", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"x": 0, "y": 20, "w": 24, "h": 6}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "sum by (detected_level) (count_over_time({service_namespace=\"mobility-manager\", service_name=\"mobility-manager\"}[1m]))", "legendFormat": "{{detected_level}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"fillOpacity": 15, "stacking": {"mode": "normal"}}}, "overrides": []}, "id": 7},
    {"type": "logs", "title": "Fehler & Warnungen", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"x": 0, "y": 26, "w": 24, "h": 10}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "{service_namespace=\"mobility-manager\", service_name=\"mobility-manager\"} | detected_level=~\"(?i)(error|warn)\""}], "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true}, "id": 8},
    {"type": "logs", "title": "Alle Logs", "datasource": {"type": "loki", "uid": "loki"}, "gridPos": {"x": 0, "y": 36, "w": 24, "h": 14}, "targets": [{"refId": "A", "datasource": {"type": "loki", "uid": "loki"}, "expr": "{service_namespace=\"mobility-manager\", service_name=\"mobility-manager\"}"}], "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true}, "id": 9}
  ]
}
